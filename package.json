{
  "name": "print-receipt-water",
  "version": "1.0.0",
  "description": "MCP Server for EPPOS EP5821 Thermal Printer - Water Bill Receipts",
  "type": "module",
  "bin": {
    "print-receipt-water": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && powershell -NoProfile -Command \"Copy-Item src/print_raw.py build/print_raw.py -Force\"",
    "start": "node build/index.js",
    "desktop:build": "dotnet build desktop/PrintReceiptWater.Desktop.csproj -c Release",
    "desktop:start": "dotnet run --project desktop/PrintReceiptWater.Desktop.csproj -c Release",
    "desktop:publish": "dotnet publish desktop/PrintReceiptWater.Desktop.csproj -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -o dist/desktop",
    "desktop:sync-assets": "powershell -NoProfile -Command \"Copy-Item src/print_raw.py desktop/assets/print_raw.py -Force\"",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "android:install": "cd android && gradlew.bat installDebug",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "android:clean": "cd android && gradlew.bat clean"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3"
  }
}
